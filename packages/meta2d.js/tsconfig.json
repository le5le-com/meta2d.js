{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/bundle",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "esnext",
    "target": "es2022",
    "lib": ["esnext", "dom", "webworker"],
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@meta2d/core": ["../core"],
      "@meta2d/math": ["../math"]
    }
  },
  "include": [
    "index.ts",
    "../core/src/**/*",
    "../core/index.ts",
    "../math/src/**/*",
    "../math/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts"
  ]
}
